 const analyzeRepeatedExtglob = (body, options) => {
+  // CashNeuro security backport for GHSA-fc5q-39xc-vjpf. Reuse the existing
+  // literal fallback for a single non-literal branch inside +(…)/(*(…)).
+  // Do this before the recursion option: disabling its limit must not disable
+  // protection against nested unbounded wildcard quantifiers.
+  const singleBranches = splitTopLevel(body).map(branch => branch.trim());
+  if (singleBranches.length === 1 && !isPlainBranch(singleBranches[0])) {
+    return { risky: true };
+  }
+
   if (options.maxExtglobRecursion === false) {
     return { risky: false };
   }
