{
  "name": "personal-finance-analyzer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:spec": "node scripts/check-spec.mjs",
    "test": "node --test packages/finance-core/test/money.test.ts packages/access/test/model.test.ts",
    "dev:web": "pnpm --filter @finance/web dev",
    "build:web": "pnpm --filter @finance/web build",
    "check:web": "pnpm --filter @finance/web check",
    "dev:admin": "pnpm --filter @finance/admin dev",
    "check:admin": "pnpm --filter @finance/admin check",
    "build:admin": "pnpm --filter @finance/admin build",
    "test:e2e": "pnpm --filter @finance/web test:e2e && pnpm --filter @finance/admin test:e2e",
    "check": "pnpm run check:spec && pnpm test && pnpm run check:web && pnpm run check:admin && pnpm run build:web && pnpm run build:admin"
  }
}
